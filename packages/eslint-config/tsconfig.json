{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": false,
		"ignoreDeprecations": "6.0"
	},
	"files": [
		"src/index.ts",
		"src/types/vendor.d.ts"
	],
	"include": [
		"scripts/**/*.ts",
		"tests/**/*.ts"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}
