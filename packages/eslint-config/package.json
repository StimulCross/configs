{
	"name": "@stimulcross/eslint-config",
	"type": "module",
	"version": "0.1.0",
	"description": "Personal ESLint configuration.",
	"author": "Stimul Cross <stimulcross@gmail.com>",
	"license": "MIT",
	"homepage": "https://github.com/StimulCross/configs/tree/main/packages/eslint-config#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/StimulCross/configs.git",
		"directory": "packages/eslint-config"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./globs": {
			"types": "./dist/globs.d.ts",
			"import": "./dist/globs.js"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"LICENSE",
		"README.md",
		"dist"
	],
	"engines": {
		"node": "^22.22.2 || >=24.15.0"
	},
	"scripts": {
		"build": "del-cli dist && tsc -p tsconfig.build.json && node scripts/copy-declarations.ts",
		"watch": "node scripts/copy-declarations.ts && tsc -p tsconfig.build.json -w",
		"clear": "del-cli dist",
		"check-types": "tsc -p tsconfig.json",
		"test": "pnpm run check:test-types && node --test --test-concurrency=2 tests/*.test.ts",
		"check:test-types": "tsc -p tsconfig.test.json",
		"generate-types": "node scripts/generate-types.ts",
		"check-generated": "node scripts/generate-types.ts --check",
		"check:package": "pnpm run build && node scripts/check-package.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "pnpm run lint && pnpm run check-types && pnpm run test && pnpm run check-generated && pnpm run check:package",
		"prepack": "pnpm run build"
	},
	"peerDependencies": {
		"eslint": "^10.4.0",
		"typescript": ">=6.0.0 <6.1.0"
	},
	"dependencies": {
		"@e18e/eslint-plugin": "0.8.1",
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/markdown": "8.0.3",
		"@stylistic/eslint-plugin": "5.10.0",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"@typescript-eslint/typescript-estree": "8.72.2",
		"@typescript-eslint/utils": "8.72.2",
		"@vitest/eslint-plugin": "1.6.28",
		"eslint-merge-processors": "2.0.0",
		"eslint-plugin-antfu": "3.3.1",
		"eslint-plugin-command": "4.0.0",
		"eslint-plugin-import-lite": "0.6.0",
		"eslint-plugin-jsdoc": "65.4.5",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-no-only-tests": "3.4.0",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-pnpm": "1.9.1",
		"eslint-plugin-regexp": "3.3.3",
		"eslint-plugin-toml": "1.5.0",
		"eslint-plugin-unicorn": "78.0.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"eslint-plugin-yml": "3.10.0",
		"globals": "17.14.0",
		"minimatch": "10.2.6",
		"toml-eslint-parser": "1.0.3",
		"yaml-eslint-parser": "2.1.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^25.9.9",
		"del-cli": "^7.0.0",
		"eslint": "^10.15.0",
		"json-schema-to-typescript-lite": "^15.0.0",
		"typescript": "^6.0.3"
	}
}
